<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mcst.module.auth.server.persistence.mapper.DepartmentMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="DepartmentBaseResultMap" type="com.mcst.module.auth.server.persistence.model.Department">
        <result column="id" property="id"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
        <result column="insert_time" property="insertTime"/>
        <result column="last_update_time" property="lastUpdateTime"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="status" property="status"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Department_Base_Column_List">
        id
        ,
            deleted,
            version,
            insert_time,
            last_update_time,
        name, code, status
    </sql>

</mapper>
